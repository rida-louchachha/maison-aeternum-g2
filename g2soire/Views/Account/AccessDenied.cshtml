@{
    ViewData["Title"] = "Access denied";
    Layout = "_AuthLayout";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 72px);">
    <div class="glass-panel p-5 text-center" style="max-width: 460px;">
        <i class="bi bi-lock" style="font-size: 2.5rem; color: #f47174;"></i>
        <h1 class="mt-3" style="font-size: 1.6rem;">Access denied</h1>
        <p class="text-secondary-soft mt-2">You don't have permission to view that part of the Maison.</p>
        <a asp-controller="Home" asp-action="Index" class="btn-maison-secondary mt-3">Back home</a>
    </div>
</div>
