@model MaisonAeternum.Web.Models.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 72px);">
    <div class="glass-panel p-5" style="max-width: 420px; width: 100%;">
        <h1 style="font-size: 1.6rem;">Forgot your password?</h1>
        <p class="text-secondary-soft mt-2 mb-4">Enter your email and we'll send you a reset link.</p>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="form-maison">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="mb-4">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" class="form-control-maison" placeholder="you@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn-maison-primary w-100">Send reset link</button>
        </form>

        <p class="text-center text-secondary-soft mt-4" style="font-size: 0.9rem;">
            <a asp-controller="Account" asp-action="Login" style="color: var(--gold);">Back to sign in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
