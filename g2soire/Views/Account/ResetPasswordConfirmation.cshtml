@{
    ViewData["Title"] = "Password reset";
    Layout = "_AuthLayout";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 72px);">
    <div class="glass-panel p-5 text-center" style="max-width: 460px;">
        <i class="bi bi-shield-check" style="font-size: 2.5rem; color: var(--gold);"></i>
        <h1 class="mt-3" style="font-size: 1.6rem;">Password reset</h1>
        <p class="text-secondary-soft mt-2">Your password has been changed. You can now sign in.</p>
        <a asp-controller="Account" asp-action="Login" class="btn-maison-primary mt-3">Sign in</a>
    </div>
</div>
