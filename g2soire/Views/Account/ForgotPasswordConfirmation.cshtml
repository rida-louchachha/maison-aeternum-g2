@{
    ViewData["Title"] = "Check your inbox";
    Layout = "_AuthLayout";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 72px);">
    <div class="glass-panel p-5 text-center" style="max-width: 460px;">
        <i class="bi bi-envelope-check" style="font-size: 2.5rem; color: var(--gold);"></i>
        <h1 class="mt-3" style="font-size: 1.6rem;">Check your inbox</h1>
        <p class="text-secondary-soft mt-2">
            If an account exists for that email, a password reset link is on its way.
        </p>
        <a asp-controller="Account" asp-action="Login" class="btn-maison-secondary mt-3">Back to sign in</a>
    </div>
</div>
