@model MaisonAeternum.Web.Models.Account.RegisterViewModel
@{
    ViewData["Title"] = "Join the Guild";
    Layout = "_AuthLayout";
}

<div class="row g-0 align-items-stretch" style="min-height: calc(100vh - 72px);">
    <div class="col-lg-6 d-none d-lg-flex flex-column justify-content-center p-5" style="background: linear-gradient(160deg, rgba(139,92,246,0.10), rgba(201,162,75,0.08));">
        <i class="bi bi-award mb-4" style="color: var(--gold); font-size: 2.5rem;"></i>
        <h2 class="gradient-text" style="font-size: 2.4rem; max-width: 420px;">Begin your apprenticeship.</h2>
        <p class="text-secondary-soft mt-3" style="max-width: 420px;">
            Join Maison Aeternum as an Apprentice, train under a Master Watchmaker, and earn your first
            guild certificate — mentored every step by Aurèle.
        </p>
    </div>

    <div class="col-lg-6 d-flex align-items-center justify-content-center p-4 p-lg-5">
        <div class="w-100" style="max-width: 420px;">
            <h1 style="font-size: 1.8rem;">Join the Guild</h1>
            <p class="text-secondary-soft mb-4">Create your apprentice account.</p>

            <form asp-controller="Account" asp-action="Register" method="post" class="form-maison">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="row">
                    <div class="col-6 mb-3">
                        <label asp-for="FirstName">First name</label>
                        <input asp-for="FirstName" class="form-control-maison" autocomplete="given-name" />
                        <span asp-validation-for="FirstName" class="field-validation-error"></span>
                    </div>
                    <div class="col-6 mb-3">
                        <label asp-for="LastName">Last name</label>
                        <input asp-for="LastName" class="form-control-maison" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" class="form-control-maison" placeholder="you@example.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" class="form-control-maison" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                    <small class="text-tertiary-soft d-block mt-1" style="font-size: 0.78rem;">
                        At least 10 characters, including an uppercase letter and a symbol.
                    </small>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword">Confirm password</label>
                    <input asp-for="ConfirmPassword" class="form-control-maison" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>

                <div class="mb-4" style="font-size: 0.85rem;">
                    <label class="d-flex align-items-start gap-2 text-secondary-soft">
                        <input asp-for="AcceptTerms" type="checkbox" class="mt-1" />
                        <span>I accept the Guild Charter and Code of Conduct.</span>
                    </label>
                    <span asp-validation-for="AcceptTerms" class="field-validation-error"></span>
                </div>

                <button type="submit" class="btn-maison-primary w-100">Create my account</button>
            </form>

            <p class="text-center text-secondary-soft mt-4" style="font-size: 0.9rem;">
                Already a member? <a asp-controller="Account" asp-action="Login" style="color: var(--gold);">Sign in</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
