@using Microsoft.AspNetCore.Identity
@using MaisonAeternum.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Maison Aeternum</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-grid.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-utilities.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar-maison">
        <div class="container d-flex align-items-center justify-content-between" style="height: 72px;">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-history" style="color: var(--gold); font-size: 1.4rem;"></i>
                <span class="brand-mark">Maison Aeternum</span>
            </a>

            <div class="d-none d-lg-flex align-items-center gap-1">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link-maison">Home</a>
                @if (SignInManager.IsSignedIn(User) && User.IsInRole("Learner"))
                {
                    <a asp-area="Learner" asp-controller="Formations" asp-action="Index" class="nav-link-maison">Formations</a>
                    <a asp-area="Learner" asp-controller="Dashboard" asp-action="Index" class="nav-link-maison">My Formations</a>
                }
                else
                {
                    <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="formations" class="nav-link-maison">Formations</a>
                }
                <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="aurele" class="nav-link-maison">Meet Aurèle</a>
                @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                {
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link-maison">Dashboard</a>
                }
            </div>

            <div class="d-flex align-items-center gap-2">
                <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle theme">
                    <i class="bi bi-moon-stars"></i>
                </button>

                @if (SignInManager.IsSignedIn(User))
                {
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-maison-ghost">Sign out</button>
                    </form>
                }
                else
                {
                    <a asp-area="" asp-controller="Account" asp-action="Login" class="btn-maison-ghost d-none d-sm-inline-flex">Sign in</a>
                    <a asp-area="" asp-controller="Account" asp-action="Register" class="btn-maison-primary">Join the Guild</a>
                }
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="border-top" style="border-color: var(--border-glass) !important;">
        <div class="container py-5 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-history" style="color: var(--gold);"></i>
                <span class="text-secondary-soft" style="font-family: var(--font-display);">Maison Aeternum</span>
            </div>
            <small class="text-tertiary-soft">&copy; 2026 Maison Aeternum. The Digital House of Horological Mastery.</small>
        </div>
    </footer>

    <div class="toast-host"></div>

    @if (TempData["ToastMessage"] != null)
    {
        <div id="server-toast-data" data-message="@TempData["ToastMessage"]" data-type="@TempData["ToastType"]" style="display:none;"></div>
    }

    @if (SignInManager.IsSignedIn(User))
    {
        <button type="button" class="ai-assistant-fab" title="Ask Aurèle" data-ai-assistant-toggle>
            <i class="bi bi-stars"></i>
        </button>

        <div class="ai-assistant-panel" data-ai-assistant-panel hidden>
            <div class="ai-assistant-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="ai-assistant-avatar-thumb">
                        <img src="~/img/aurele-avatar.svg" alt="Aurèle" />
                    </div>
                    <div>
                        <div class="ai-assistant-name">Aurèle</div>
                        <div class="ai-assistant-status" data-ai-status>Connecting…</div>
                    </div>
                </div>
                <button type="button" class="btn-maison-ghost" data-ai-assistant-close aria-label="Close Aurèle">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="ai-assistant-avatar-stage" data-ai-avatar-stage>
                <video data-ai-avatar-video autoplay playsinline muted></video>
                <img data-ai-avatar-static src="~/img/aurele-avatar.svg" alt="Aurèle" />
            </div>

            <div class="ai-assistant-messages" data-ai-messages></div>

            <form class="ai-assistant-composer" data-ai-composer>
                <button type="button" class="ai-mic-btn" data-ai-mic title="Speak your question" aria-label="Voice input">
                    <i class="bi bi-mic"></i>
                </button>
                <input type="text" placeholder="Ask Aurèle anything…" data-ai-input autocomplete="off" />
                <button type="submit" class="btn-maison-primary" data-ai-send aria-label="Send">
                    <i class="bi bi-send"></i>
                </button>
            </form>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (SignInManager.IsSignedIn(User))
    {
        <script src="~/js/ai-assistant.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
