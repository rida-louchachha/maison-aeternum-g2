@model MaisonAeternum.Application.Learning.Models.ModulePlayerDto
@{
    ViewData["Title"] = Model.ModuleTitle;
}

<div class="container py-5" style="max-width: 780px;">
    <a asp-controller="Formations" asp-action="Details" asp-route-id="@Model.FormationId" class="text-tertiary-soft" style="font-size: 0.85rem;">
        <i class="bi bi-arrow-left"></i> @Model.FormationTitle
    </a>
    <h1 style="font-size: 1.8rem; margin: 0.25rem 0 1rem;">@Model.ModuleTitle</h1>
    <p class="text-secondary-soft">@Model.ModuleDescription</p>

    <div class="d-flex flex-column gap-3 mt-4">
        @foreach (var item in Model.ContentItems)
        {
            <div class="glass-card p-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi @(item.Type == MaisonAeternum.Domain.Enums.ContentItemType.Video ? "bi-play-circle" : item.Type == MaisonAeternum.Domain.Enums.ContentItemType.Pdf ? "bi-file-earmark-pdf" : "bi-headphones")"
                       style="color: var(--gold); font-size: 1.2rem;"></i>
                    <div>
                        <div style="font-weight: 500;">@item.Title</div>
                        <div class="text-tertiary-soft" style="font-size: 0.78rem;">@item.Type · @item.DurationMinutes min</div>
                    </div>
                </div>

                @if (item.Type == MaisonAeternum.Domain.Enums.ContentItemType.Video)
                {
                    <video controls style="width: 100%; border-radius: var(--radius-sm); background: #000;" src="@item.ExternalUrl"></video>
                }
                else if (item.Type == MaisonAeternum.Domain.Enums.ContentItemType.Audio)
                {
                    <audio controls style="width: 100%;" src="@item.ExternalUrl"></audio>
                }
                else
                {
                    <a href="@item.ExternalUrl" target="_blank" class="btn-maison-secondary"><i class="bi bi-box-arrow-up-right"></i> Open document</a>
                }
            </div>
        }
    </div>

    <div class="glass-card p-4 mt-4 d-flex justify-content-between align-items-center">
        <div>
            @if (Model.IsCompleted)
            {
                <span class="stat-delta up"><i class="bi bi-check-lg"></i> Completed</span>
            }
            else
            {
                <span class="text-secondary-soft" style="font-size: 0.85rem;">Mark this module complete once you've reviewed the material.</span>
            }
        </div>
        <div class="d-flex gap-2">
            @if (Model.HasQuiz)
            {
                <a asp-controller="Quizzes" asp-action="Take" asp-route-quizId="@Model.QuizId" class="btn-maison-secondary">
                    <i class="bi bi-patch-question"></i> Module quiz
                </a>
            }
            @if (!Model.IsCompleted)
            {
                <form asp-controller="Modules" asp-action="Complete" asp-route-id="@Model.ModuleId" asp-route-formationId="@Model.FormationId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-maison-primary">Mark complete</button>
                </form>
            }
        </div>
    </div>
</div>
