@model MaisonAeternum.Application.Assessment.Models.QuizFormDto
@{
    ViewData["Title"] = "Edit Quiz";
    var questions = (List<MaisonAeternum.Application.Assessment.Models.QuestionAdminDto>)ViewBag.Questions;
}

<div class="mb-4">
    <h2 style="font-size: 1.4rem;">@Model.Title</h2>
    <p class="text-secondary-soft">@Model.Type · Passing score @Model.PassingScore%</p>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <form asp-action="Edit" method="post" class="form-maison glass-card p-4">
            @Html.AntiForgeryToken()
            <partial name="_QuizFields" />
            <button type="submit" class="btn-maison-primary">Save changes</button>
        </form>

        <form asp-action="Delete" asp-route-id="@Model.Id" asp-route-moduleId="@(Model.ModuleId ?? 0)" asp-route-formationId="@Model.FormationId"
              method="post" class="mt-3" onsubmit="return confirm('Delete this quiz and all its questions?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-maison-ghost"><i class="bi bi-trash"></i> Delete quiz</button>
        </form>
    </div>

    <div class="col-lg-6">
        <div class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 style="font-size: 1rem; margin: 0;">Questions (@questions.Count)</h3>
                <a asp-action="CreateQuestion" asp-route-quizId="@Model.Id" class="btn-maison-secondary" style="font-size: 0.8rem; padding: 0.4rem 0.9rem;">
                    <i class="bi bi-plus-lg"></i> Add
                </a>
            </div>

            @if (!questions.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="bi bi-patch-question"></i></div>
                    <p class="mb-0">No questions yet.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var question in questions)
                    {
                        <div class="p-2" style="border: 1px solid var(--border-glass); border-radius: var(--radius-sm);">
                            <div class="d-flex justify-content-between align-items-start">
                                <div style="font-size: 0.88rem; max-width: 75%;">@question.Text</div>
                                <div class="d-flex gap-1">
                                    <a asp-action="EditQuestion" asp-route-id="@question.Id" class="btn-maison-ghost" style="padding: 0.3rem 0.6rem;"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="DeleteQuestion" asp-route-id="@question.Id" asp-route-quizId="@Model.Id" method="post" onsubmit="return confirm('Delete this question?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-maison-ghost" style="padding: 0.3rem 0.6rem;"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </div>
                            <div class="text-tertiary-soft" style="font-size: 0.75rem; margin-top: 0.3rem;">
                                @question.Type · @question.Points pts · correct: @question.CorrectAnswersSummary
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
