@model MaisonAeternum.Application.Assessment.Models.QuizFormDto
@{
    ViewData["Title"] = "New Module Quiz";
}

<div class="mb-4">
    <h2 style="font-size: 1.4rem;">New Module Quiz</h2>
</div>

<form asp-action="CreateForModule" method="post" class="form-maison glass-card p-4" style="max-width: 640px;">
    @Html.AntiForgeryToken()
    <partial name="_QuizFields" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn-maison-primary">Create quiz</button>
        <a asp-controller="Modules" asp-action="Edit" asp-route-id="@Model.ModuleId" class="btn-maison-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
