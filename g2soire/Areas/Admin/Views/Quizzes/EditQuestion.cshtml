@model MaisonAeternum.Application.Assessment.Models.QuestionFormDto
@{
    ViewData["Title"] = "Edit Question";
}

<div class="mb-4">
    <h2 style="font-size: 1.4rem;">Edit Question</h2>
</div>

<form asp-action="EditQuestion" method="post" class="form-maison glass-card p-4" style="max-width: 640px;">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="QuizId" />
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="mb-3">
        <label asp-for="Type">Type</label>
        <select asp-for="Type" class="form-control-maison" asp-items="Html.GetEnumSelectList<MaisonAeternum.Domain.Enums.QuestionType>()"></select>
    </div>

    <div class="mb-3">
        <label asp-for="Text">Question text</label>
        <textarea asp-for="Text" class="form-control-maison" rows="2"></textarea>
        <span asp-validation-for="Text" class="field-validation-error"></span>
    </div>

    <div class="mb-3">
        <label>Answer options — check the correct one(s)</label>
        @for (var i = 0; i < Model.Options.Count; i++)
        {
            <div class="d-flex align-items-center gap-2 mb-2">
                <input asp-for="Options[i].IsCorrect" type="checkbox" />
                <input asp-for="Options[i].Text" class="form-control-maison" placeholder="Option @(i + 1)" />
            </div>
        }
        <span asp-validation-for="Options" class="field-validation-error"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Explanation">Explanation</label>
        <textarea asp-for="Explanation" class="form-control-maison" rows="2"></textarea>
        <span asp-validation-for="Explanation" class="field-validation-error"></span>
    </div>

    <div class="row">
        <div class="col-6 mb-4">
            <label asp-for="Points">Points</label>
            <input asp-for="Points" type="number" class="form-control-maison" />
        </div>
        <div class="col-6 mb-4">
            <label asp-for="DisplayOrder">Display order</label>
            <input asp-for="DisplayOrder" type="number" class="form-control-maison" />
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn-maison-primary">Save changes</button>
        <a asp-action="Edit" asp-route-id="@Model.QuizId" class="btn-maison-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
