@model MaisonAeternum.Application.Catalog.Models.CreateTrainerDto
@{
    ViewData["Title"] = "New Trainer";
}

<div class="mb-4">
    <h2 style="font-size: 1.4rem;">New Trainer</h2>
    <p class="text-secondary-soft">A temporary password will be generated — share it securely with the trainer.</p>
</div>

<form asp-action="Create" method="post" class="form-maison glass-card p-4" style="max-width: 640px;">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="row">
        <div class="col-6 mb-3">
            <label asp-for="FirstName">First name</label>
            <input asp-for="FirstName" class="form-control-maison" />
            <span asp-validation-for="FirstName" class="field-validation-error"></span>
        </div>
        <div class="col-6 mb-3">
            <label asp-for="LastName">Last name</label>
            <input asp-for="LastName" class="form-control-maison" />
            <span asp-validation-for="LastName" class="field-validation-error"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" class="form-control-maison" />
        <span asp-validation-for="Email" class="field-validation-error"></span>
    </div>

    <hr style="border-color: var(--border-glass); margin: 1.5rem 0;" />

    <div class="mb-3">
        <label asp-for="Profile.Biography">Biography</label>
        <textarea asp-for="Profile.Biography" class="form-control-maison" rows="3"></textarea>
        <span asp-validation-for="Profile.Biography" class="field-validation-error"></span>
    </div>

    <div class="row">
        <div class="col-8 mb-3">
            <label asp-for="Profile.AtelierAffiliation">Atelier affiliation</label>
            <input asp-for="Profile.AtelierAffiliation" class="form-control-maison" placeholder="Atelier Verrier, Geneva" />
            <span asp-validation-for="Profile.AtelierAffiliation" class="field-validation-error"></span>
        </div>
        <div class="col-4 mb-3">
            <label asp-for="Profile.YearsOfExperience">Years of experience</label>
            <input asp-for="Profile.YearsOfExperience" type="number" class="form-control-maison" />
            <span asp-validation-for="Profile.YearsOfExperience" class="field-validation-error"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-6 mb-3">
            <label>Instagram</label>
            <input asp-for="Profile.SocialLinks[0].Url" class="form-control-maison" placeholder="https://instagram.com/..." />
            <input type="hidden" asp-for="Profile.SocialLinks[0].Platform" />
        </div>
        <div class="col-6 mb-3">
            <label>LinkedIn</label>
            <input asp-for="Profile.SocialLinks[1].Url" class="form-control-maison" placeholder="https://linkedin.com/in/..." />
            <input type="hidden" asp-for="Profile.SocialLinks[1].Platform" />
        </div>
    </div>

    <div class="mb-4" style="font-size: 0.9rem;">
        <label class="d-flex align-items-center gap-2 text-secondary-soft">
            <input asp-for="Profile.IsFeatured" type="checkbox" />
            Feature on the public landing page
        </label>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn-maison-primary">Create trainer</button>
        <a asp-action="Index" class="btn-maison-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
