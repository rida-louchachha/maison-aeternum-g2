@model MaisonAeternum.Application.Catalog.Models.TrainerProfileFormDto
@{
    ViewData["Title"] = "Edit Trainer";
}

<div class="mb-4">
    <h2 style="font-size: 1.4rem;">Edit Trainer</h2>
</div>

<form asp-action="Edit" method="post" class="form-maison glass-card p-4" style="max-width: 640px;">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="mb-3">
        <label asp-for="Biography">Biography</label>
        <textarea asp-for="Biography" class="form-control-maison" rows="3"></textarea>
        <span asp-validation-for="Biography" class="field-validation-error"></span>
    </div>

    <div class="row">
        <div class="col-8 mb-3">
            <label asp-for="AtelierAffiliation">Atelier affiliation</label>
            <input asp-for="AtelierAffiliation" class="form-control-maison" />
            <span asp-validation-for="AtelierAffiliation" class="field-validation-error"></span>
        </div>
        <div class="col-4 mb-3">
            <label asp-for="YearsOfExperience">Years of experience</label>
            <input asp-for="YearsOfExperience" type="number" class="form-control-maison" />
            <span asp-validation-for="YearsOfExperience" class="field-validation-error"></span>
        </div>
    </div>

    <div class="row">
        @for (var i = 0; i < Model.SocialLinks.Count; i++)
        {
            <div class="col-6 mb-3">
                <label>@Model.SocialLinks[i].Platform</label>
                <input asp-for="SocialLinks[i].Url" class="form-control-maison" />
                <input type="hidden" asp-for="SocialLinks[i].Platform" />
            </div>
        }
    </div>

    <div class="mb-4" style="font-size: 0.9rem;">
        <label class="d-flex align-items-center gap-2 text-secondary-soft">
            <input asp-for="IsFeatured" type="checkbox" />
            Feature on the public landing page
        </label>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn-maison-primary">Save changes</button>
        <a asp-action="Index" class="btn-maison-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
