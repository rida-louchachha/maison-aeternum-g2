@model MaisonAeternum.Application.Catalog.Models.ContentItemFormDto
@{
    ViewData["Title"] = "Edit Content";
}

<div class="mb-4">
    <h2 style="font-size: 1.4rem;">Edit Content</h2>
</div>

<form asp-action="EditContentItem" method="post" class="form-maison glass-card p-4" style="max-width: 560px;">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ModuleId" />
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="mb-3">
        <label asp-for="Type">Type</label>
        <select asp-for="Type" class="form-control-maison" asp-items="Html.GetEnumSelectList<MaisonAeternum.Domain.Enums.ContentItemType>()"></select>
    </div>

    <div class="mb-3">
        <label asp-for="Title">Title</label>
        <input asp-for="Title" class="form-control-maison" />
        <span asp-validation-for="Title" class="field-validation-error"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ExternalUrl">URL</label>
        <input asp-for="ExternalUrl" class="form-control-maison" />
        <span asp-validation-for="ExternalUrl" class="field-validation-error"></span>
    </div>

    <div class="row">
        <div class="col-6 mb-4">
            <label asp-for="DurationMinutes">Duration (minutes)</label>
            <input asp-for="DurationMinutes" type="number" class="form-control-maison" />
        </div>
        <div class="col-6 mb-4">
            <label asp-for="DisplayOrder">Display order</label>
            <input asp-for="DisplayOrder" type="number" class="form-control-maison" />
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn-maison-primary">Save changes</button>
        <a asp-action="Edit" asp-route-id="@Model.ModuleId" class="btn-maison-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
