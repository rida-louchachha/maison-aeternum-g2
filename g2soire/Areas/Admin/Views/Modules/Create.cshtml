@model MaisonAeternum.Application.Catalog.Models.ModuleFormDto
@{
    ViewData["Title"] = "New Module";
}

<div class="mb-4">
    <h2 style="font-size: 1.4rem;">New Module</h2>
</div>

<form asp-action="Create" method="post" class="form-maison glass-card p-4" style="max-width: 560px;">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="FormationId" />
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="mb-3">
        <label asp-for="Title">Title</label>
        <input asp-for="Title" class="form-control-maison" />
        <span asp-validation-for="Title" class="field-validation-error"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description">Description</label>
        <textarea asp-for="Description" class="form-control-maison" rows="3"></textarea>
        <span asp-validation-for="Description" class="field-validation-error"></span>
    </div>

    <div class="row">
        <div class="col-6 mb-4">
            <label asp-for="DisplayOrder">Display order</label>
            <input asp-for="DisplayOrder" type="number" class="form-control-maison" />
            <span asp-validation-for="DisplayOrder" class="field-validation-error"></span>
        </div>
        <div class="col-6 mb-4">
            <label asp-for="EstimatedMinutes">Estimated minutes</label>
            <input asp-for="EstimatedMinutes" type="number" class="form-control-maison" />
            <span asp-validation-for="EstimatedMinutes" class="field-validation-error"></span>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn-maison-primary">Create module</button>
        <a asp-action="Index" asp-route-formationId="@Model.FormationId" class="btn-maison-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
